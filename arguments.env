# Application settings, as environment variables.
#
# This is NOT the Kafka client config -- that lives in client.properties (see
# client.properties.example) and uses java properties format. Pointing
# CONSUMER_CONFIG_FILE at this file will fail: librdkafka rejects INPUT_TOPIC
# and friends as unknown properties.

# Path to the Kafka client properties file.
CONSUMER_CONFIG_FILE=<client_properties_filepath>
INPUT_TOPIC=<INPUT_TOPIC_name>
GROUP_ID=<consumer_group_ID>
RUN_INTERVAL=<seconds_Default_120>

# Where each timestamp comes from.
T1=<IngestionTime|value.field|key.field_Default_IngestionTime>
T2=<IngestionTime|consumerWallClockTime_Default_consumerWallClockTime>

# How to read T1 when it comes from the message body.
DATE_TIME_FORMAT=<epoch|strptime_format_Default_epoch>
T1_UNIT=<s|ms|us|ns_Default_ms>
T1_TIMEZONE=<utc|local_Default_utc>
VALUE_DESERIALIZER=<Avro|JSONSchema|Protobuf|JSON|String_Deserializer>
KEY_DESERIALIZER=<Avro|JSONSchema|Protobuf|JSON|String_Deserializer>
# Only for ProtobufDeserializer, and only when the .proto declares more than
# one message. Defaults to the first message in the schema.
PROTOBUF_MESSAGE_NAME=<fully.qualified.MessageName>

# Where results go: localFileDump or dumpToTopic.
CONSUMER_OUTPUT=<consumer_output_type>
RESULT_DUMP_LOCAL_FILEPATH=<csv_filepath_for_localFileDump>
OUTPUT_TOPIC=<output_topic_name_for_dumpToTopic>
PRODUCER_CONFIG_FILE=<producer_properties_filepath_for_dumpToTopic>
